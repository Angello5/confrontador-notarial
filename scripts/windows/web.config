<?xml version="1.0" encoding="utf-8"?>
<!-- F8 · Sitio del ERP en IIS: HttpPlatformHandler arranca waitress con iniciar.ps1.
     /static/ lo sirve IIS desde C:\ConfrontadorNotarial\staticfiles (directorio virtual). -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="ConfrontadorWaitress" path="*" verb="*" modules="httpPlatformHandler"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
                  arguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\ConfrontadorNotarial\app\scripts\windows\iniciar.ps1 -Rol web"
                  startupTimeLimit="120" startupRetryCount="3"
                  processesPerApplication="1" stdoutLogEnabled="false" />
    <security>
      <requestFiltering>
        <!-- 25 MB por archivo (EXPEDIENTES_MAX_FILE_SIZE) más margen del formulario. -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
