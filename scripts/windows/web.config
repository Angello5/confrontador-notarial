<?xml version="1.0" encoding="utf-8"?>
<!--
  F8 · Sitio de IIS del ERP (raíz física: C:\ConfrontadorNotarial\actual).
  instalar.ps1 lo copia a la raíz del sitio. HttpPlatformHandler arranca y
  supervisa la web con iniciar.ps1; las claves quedan en erp.env.
  Contrato: specs/046-despliegue/contracts/servidor.md
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="ConfrontadorWeb" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
                  arguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;C:\ConfrontadorNotarial\actual\scripts\windows\iniciar.ps1&quot; -Rol web"
                  processesPerApplication="1"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  stdoutLogEnabled="false" />
    <rewrite>
      <rules>
        <rule name="Solo HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Durante una actualización, actualizar.ps1 crea este archivo y todo va a la página de mantenimiento. -->
        <rule name="Mantenimiento" stopProcessing="true">
          <match url="^static/" negate="true" />
          <conditions>
            <add input="C:\ConfrontadorNotarial\estado\mantenimiento" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="static/mantenimiento.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <!-- /static/ es un directorio virtual sobre C:\ConfrontadorNotarial\staticfiles: lo sirve IIS, sin Python. -->
  <location path="static">
    <system.webServer>
      <handlers>
        <remove name="ConfrontadorWeb" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
