# F8 · Configuración del ERP en el servidor de la notaría.
# Copiar a C:\ProgramData\ConfrontadorNotarial\erp.env y completar.
# Ese archivo solo lo leen la cuenta de servicio y Administradores (instalar.ps1).
# Una línea NOMBRE=valor por variable; las líneas con # se ignoran.
# Contrato: specs/046-despliegue/contracts/servidor.md

# Clave secreta de Django: una cadena aleatoria larga, distinta en cada servidor.
DJANGO_SECRET_KEY=
# Nombre interno con el que entran las PC (DNS de la notaría).
DJANGO_ALLOWED_HOSTS=erp.notaria.local

# Base del ERP en SQL Server (F63, scripts/sqlserver/crear_base.sql).
DB_HOST=localhost
DB_NAME=confrontador
DB_USER=confrontador
DB_PASSWORD=
# Solo si SQL Server usa un certificado propio que las PC no reconocen.
DB_TRUST_SERVER_CERTIFICATE=

# Marca de la notaría (F28, F29). El logo vive en
# C:\ConfrontadorNotarial\staticfiles\marca\logo.png, compartido entre versiones.
ERP_NOMBRE=
ERP_LOGO=/static/marca/logo.png
ERP_DIRECCION=

# Carpetas del ERP (specs/046-despliegue/data-model.md).
EXPEDIENTES_TEMP_DIR=C:\ConfrontadorNotarial\temporales
EXPEDIENTES_ORIGINALES_DIR=C:\ConfrontadorNotarial\originales
ERP_STATIC_ROOT=C:\ConfrontadorNotarial\staticfiles
ERP_REGISTROS_DIR=C:\ConfrontadorNotarial\registros
ERP_ESTADO_DIR=C:\ConfrontadorNotarial\estado

# Respaldos en otro disco del servidor (30 días).
RESPALDO_DIR=E:\Respaldos\ConfrontadorNotarial

# Huella (thumbprint) del certificado HTTPS enlazado al sitio de IIS.
IIS_CERTIFICADO=

# Capa de sentido (F61): apagada salvo decisión de la notaría.
SENTIDO_ACTIVO=
