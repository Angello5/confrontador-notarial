# ---- Datos de expedientes: NUNCA se versionan ----
# Contienen DNI, nombres, domicilios y escrituras de personas reales.
Cliente/
Proyecto*/
Resultado/
Plantilla/
# `expedientes/` es código versionado; los datos reales se guardan en esta
# carpeta local con nombre explícito para mantener la protección por defecto.
expedientes_locales/
# Un expediente por carpeta con sufijo numérico de cinco dígitos.
*-[0-9][0-9][0-9][0-9][0-9]/
*.docx
*.doc
*.pdf
*.jpg
*.jpeg
*.png
*.xlsx
*.xls
*.rtf
*.odt
*.tif
*.tiff
*.bmp
*.webp
tests/fixtures/
!docs/*.png

# ---- Secretos ----
.env
.env.*
!.env.example
*.key

# ---- Cachés y artefactos ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.scannerwork/
dist/
*.egg-info/
capturas*/
staticfiles/

# ---- Sistema ----
.DS_Store
.venv/
venv/
.codebase-memory/
